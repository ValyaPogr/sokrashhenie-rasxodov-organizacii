<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:storm="http://storm.bpmn2.ru/ns" id="Definitions_VitaStore_Task2" targetNamespace="http://vitastore.example/bpmn">
  <bpmn:collaboration id="Collaboration_Onboarding">
    <bpmn:participant id="Participant_Store" name="1. Новый магазин / Legacy POS" processRef="Process_Store" />
    <bpmn:participant id="Participant_Onboarding" name="2. Onboarding Service" processRef="Process_Onboarding" />
    <bpmn:participant id="Participant_AI" name="3. AI SKU Matching Service" processRef="Process_AI" />
    <bpmn:participant id="Participant_ERP" name="4. VitaStore ERP" processRef="Process_ERP" />
    <bpmn:participant id="Participant_Merch" name="5. Товаровед" processRef="Process_Merch" />
    <bpmn:messageFlow id="MF_StoreDump" name="Product Dump" sourceRef="Task_PrepareDump" targetRef="Start_Onboarding" />
    <bpmn:messageFlow id="MF_RetryDump" name="Запрос повторной выгрузки" targetRef="Task_PrepareDump" />
    <bpmn:messageFlow id="MF_ToAI" name="Normalized Product Dataset" sourceRef="Task_SendToAI" targetRef="Start_AI" />
    <bpmn:messageFlow id="MF_FromAI" name="AI Matching Result" sourceRef="Task_SendAIResult" targetRef="Task_ReceiveAI" />
    <bpmn:messageFlow id="MF_ToERP_Catalog" name="Запрос Master SKU" sourceRef="Task_GetMasterSKU" targetRef="Start_ERP_Catalog" />
    <bpmn:messageFlow id="MF_FromERP_Catalog" name="Master SKU" sourceRef="Task_ProvideMasterSKU" targetRef="Task_GetMasterSKU" />
    <bpmn:messageFlow id="MF_ToHuman" name="Mapping Exception Queue" sourceRef="Task_SendExceptions" targetRef="Start_Human" />
    <bpmn:messageFlow id="MF_FromHuman" name="Human-approved Mapping" sourceRef="Task_ReturnHuman" targetRef="Task_MergeMapping" />
    <bpmn:messageFlow id="MF_ToERP_Mapping" name="Validated Mapping" sourceRef="Task_SendMapping" targetRef="Start_ERP_Mapping" />
    <bpmn:messageFlow id="MF_FromERP_Status" name="Load Status" sourceRef="Task_SendStatus" targetRef="Task_ReceiveStatus" />
    <bpmn:messageFlow id="MF_ToPOS" name="POS Dataset" sourceRef="Task_SendPOSData" />
    <bpmn:messageFlow id="Flow_1213a70" sourceRef="Task_PrepareDump" targetRef="Start_Onboarding" />
    <bpmn:messageFlow id="Flow_00s7exi" sourceRef="Task_SendToAI" targetRef="Start_AI" />
    <bpmn:messageFlow id="Flow_04g5tcv" sourceRef="Task_SendExceptions" targetRef="Start_Human" />
    <bpmn:messageFlow id="Flow_0rgbuyu" sourceRef="Task_SendStatus" targetRef="Task_ReceiveStatus" />
    <bpmn:messageFlow id="Flow_1j87t14" sourceRef="Task_SendAIResult" targetRef="Task_ReceiveAI" />
    <bpmn:messageFlow id="Flow_0hqiere" sourceRef="Task_GetMasterSKU" targetRef="Start_ERP_Catalog" />
    <bpmn:messageFlow id="Flow_0nhbjsv" sourceRef="Task_ProvideMasterSKU" targetRef="Task_Match" />
    <bpmn:messageFlow id="Flow_1gxq7rt" sourceRef="Task_SendMapping" targetRef="Start_ERP_Mapping" />
    <bpmn:messageFlow id="Flow_1ax8tz8" sourceRef="Task_ReturnHuman" targetRef="Task_MergeMapping" />
    <bpmn:messageFlow id="Flow_1amsbto" sourceRef="Activity_0xyhcq4" targetRef="Event_0uujidi" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Store" name="Новый магазин / Legacy POS" isExecutable="false">
    <bpmn:sequenceFlow id="SF_Store_1" sourceRef="Start_Store" targetRef="Task_PrepareDump" />
    <bpmn:startEvent id="Start_Store" name="Получена команда на подключение">
      <bpmn:outgoing>Flow_0wlz82p</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_PrepareDump" name="1.1. Подготовить выгрузку номенклатуры">
      <bpmn:incoming>Flow_0wlz82p</bpmn:incoming>
      <bpmn:outgoing>Flow_1333v6o</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0srspz0">
        <bpmn:targetRef>Data_ProductDump</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:dataObjectReference id="Data_ProductDump" name="Product Dump" />
    <bpmn:intermediateCatchEvent id="Event_0uujidi" name="Получен статус подключения" storm:LabelWidth="77" storm:LabelHeight="24">
      <bpmn:incoming>Flow_1333v6o</bpmn:incoming>
      <bpmn:outgoing>Flow_0dkvb6d</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0w8j30v" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Event_1a598y5" name="Касса подключена к POS dataset">
      <bpmn:incoming>Flow_0dkvb6d</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0wlz82p" sourceRef="Start_Store" targetRef="Task_PrepareDump" />
    <bpmn:sequenceFlow id="Flow_1333v6o" sourceRef="Task_PrepareDump" targetRef="Event_0uujidi" />
    <bpmn:sequenceFlow id="Flow_0dkvb6d" sourceRef="Event_0uujidi" targetRef="Event_1a598y5" />
    <bpmn:association id="Assoc_ProductDump" sourceRef="Task_PrepareDump" targetRef="Data_ProductDump" />
  </bpmn:process>
  <bpmn:process id="Process_Onboarding" name="Onboarding Service" isExecutable="true">
    <bpmn:sequenceFlow id="SF_O_1" sourceRef="Start_Onboarding" targetRef="Task_Register" />
    <bpmn:sequenceFlow id="SF_O_2" sourceRef="Task_Register" targetRef="Task_ValidateInput" />
    <bpmn:sequenceFlow id="SF_O_3" sourceRef="Task_ValidateInput" />
    <bpmn:sequenceFlow id="SF_O_4_NO" name="Нет" />
    <bpmn:sequenceFlow id="SF_O_5_YES" name="Да" targetRef="Task_SendToAI" />
    <bpmn:sequenceFlow id="SF_O_6" sourceRef="Task_SendToAI" targetRef="Task_ReceiveAI" />
    <bpmn:sequenceFlow id="SF_O_7" sourceRef="Task_ReceiveAI" targetRef="Task_BusinessValidation" />
    <bpmn:sequenceFlow id="SF_O_8" sourceRef="Task_BusinessValidation" targetRef="GW_MappingValid" />
    <bpmn:sequenceFlow id="SF_O_9_PASS" name="PASS: confidence ≥95% + business validation" sourceRef="GW_MappingValid" targetRef="Task_AutoApprove" />
    <bpmn:sequenceFlow id="SF_O_10_EXCEPTION" name="EXCEPTION: confidence &#60;95% или validation fail" sourceRef="GW_MappingValid" targetRef="Task_SendExceptions" />
    <bpmn:sequenceFlow id="SF_O_11" sourceRef="Task_AutoApprove" targetRef="Task_MergeMapping" />
    <bpmn:sequenceFlow id="SF_O_12" sourceRef="Task_MergeMapping" targetRef="Task_SendMapping" />
    <bpmn:sequenceFlow id="SF_O_13" sourceRef="Task_SendMapping" targetRef="Task_ReceiveStatus" />
    <bpmn:sequenceFlow id="SF_O_14" sourceRef="Task_ReceiveStatus" />
    <bpmn:sequenceFlow id="SF_O_15_OK" name="Да" targetRef="Task_ControlCheck" />
    <bpmn:sequenceFlow id="SF_O_16_ERR" name="Нет" targetRef="Task_SendMapping" />
    <bpmn:sequenceFlow id="SF_O_17" sourceRef="Task_ControlCheck" />
    <bpmn:sequenceFlow id="SF_O_18_OK" name="Да" targetRef="End_Onboarding" />
    <bpmn:sequenceFlow id="SF_O_19_ERR" name="Нет" targetRef="Task_SendMapping" />
    <bpmn:sequenceFlow id="Flow_07sayqn" sourceRef="Task_SendToAI" targetRef="Task_ReceiveAI" />
    <bpmn:sequenceFlow id="Flow_19l7xhj" name="да" sourceRef="GW_MappingValid" targetRef="Task_AutoApprove" />
    <bpmn:sequenceFlow id="Flow_1404ay8" name="нет" sourceRef="GW_MappingValid" targetRef="Task_SendExceptions" />
    <bpmn:sequenceFlow id="Flow_05w7s6k" sourceRef="Task_BusinessValidation" targetRef="GW_MappingValid" />
    <bpmn:sequenceFlow id="Flow_135dmqj" sourceRef="Task_ReceiveAI" targetRef="Task_BusinessValidation" />
    <bpmn:sequenceFlow id="Flow_1gksvhr" sourceRef="Task_AutoApprove" targetRef="Task_MergeMapping" />
    <bpmn:sendTask id="Task_SendToAI" name="2.3. Передать данные на нормализацию / matching">
      <bpmn:incoming>Flow_1cgpo51</bpmn:incoming>
      <bpmn:outgoing>Flow_07sayqn</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_05qdgpk">
        <bpmn:targetRef>Data_Normalized</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_ReceiveAI" name="2.5. Получить результат AI Matching">
      <bpmn:incoming>Flow_07sayqn</bpmn:incoming>
      <bpmn:outgoing>Flow_135dmqj</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1vovhsq">
        <bpmn:targetRef>Data_AIResult</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="GW_MappingValid" name="Confidence ≥ 95%?" default="Flow_1404ay8" storm:LabelWidth="104" storm:LabelHeight="24">
      <bpmn:incoming>Flow_05w7s6k</bpmn:incoming>
      <bpmn:outgoing>Flow_19l7xhj</bpmn:outgoing>
      <bpmn:outgoing>Flow_1404ay8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AutoApprove" name="2.7. Автоматически подтвердить mapping">
      <bpmn:incoming>Flow_19l7xhj</bpmn:incoming>
      <bpmn:outgoing>Flow_1gksvhr</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_SendExceptions" name="2.8. Передать исключения товароведу">
      <bpmn:incoming>Flow_1404ay8</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:dataObjectReference id="Data_Normalized" name="Normalized Product Dataset" />
    <bpmn:serviceTask id="Task_BusinessValidation" name="2.6. Business Validation">
      <bpmn:incoming>Flow_135dmqj</bpmn:incoming>
      <bpmn:outgoing>Flow_05w7s6k</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataObjectReference id="Data_AIResult" name="AI Matching Result" />
    <bpmn:sequenceFlow id="Flow_1cgpo51" sourceRef="Task_ValidateInput" targetRef="Task_SendToAI" />
    <bpmn:serviceTask id="Task_Register" name="2.1. Зарегистрировать onboarding">
      <bpmn:incoming>Flow_18aa653</bpmn:incoming>
      <bpmn:outgoing>Flow_1k7rifr</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="Start_Onboarding" name="Получен Product Dump">
      <bpmn:outgoing>Flow_18aa653</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_Start_Onboarding" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_18aa653" sourceRef="Start_Onboarding" targetRef="Task_Register" />
    <bpmn:sequenceFlow id="Flow_1k7rifr" sourceRef="Task_Register" targetRef="Task_ValidateInput" />
    <bpmn:endEvent id="End_Onboarding" name="Магазин подключён">
      <bpmn:incoming>Flow_1orzzs5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Activity_0xyhcq4" name="2.13. Передать каталог в POS">
      <bpmn:incoming>Flow_002wo35</bpmn:incoming>
      <bpmn:outgoing>Flow_1orzzs5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_ControlCheck" name="2.10. Выполнить контрольную проверку">
      <bpmn:incoming>Flow_167wdx3</bpmn:incoming>
      <bpmn:outgoing>Flow_0ne8fkv</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_MergeMapping" name="2.9. Объединить подтверждённый mapping">
      <bpmn:incoming>Flow_1gksvhr</bpmn:incoming>
      <bpmn:outgoing>Flow_167wdx3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1s7qmx7">
        <bpmn:targetRef>Data_ValidatedMapping</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_SendMapping" name="2.11. Передать mapping в ERP">
      <bpmn:incoming>Flow_0ne8fkv</bpmn:incoming>
      <bpmn:outgoing>Flow_0hjbvw1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_ReceiveStatus" name="2.12. Получить статус загрузки">
      <bpmn:incoming>Flow_0hjbvw1</bpmn:incoming>
      <bpmn:outgoing>Flow_002wo35</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:dataObjectReference id="Data_ValidatedMapping" name="Validated SKU Mapping" />
    <bpmn:sequenceFlow id="Flow_1orzzs5" sourceRef="Activity_0xyhcq4" targetRef="End_Onboarding" />
    <bpmn:sequenceFlow id="Flow_002wo35" sourceRef="Task_ReceiveStatus" targetRef="Activity_0xyhcq4" />
    <bpmn:sequenceFlow id="Flow_167wdx3" sourceRef="Task_MergeMapping" targetRef="Task_ControlCheck" />
    <bpmn:sequenceFlow id="Flow_0ne8fkv" sourceRef="Task_ControlCheck" targetRef="Task_SendMapping" />
    <bpmn:sequenceFlow id="Flow_0hjbvw1" sourceRef="Task_SendMapping" targetRef="Task_ReceiveStatus" />
    <bpmn:serviceTask id="Task_ValidateInput" name="2.2. Проверить формат и качество данных">
      <bpmn:incoming>Flow_1k7rifr</bpmn:incoming>
      <bpmn:outgoing>Flow_1cgpo51</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:association id="Assoc_Normalized" sourceRef="Task_SendToAI" targetRef="Data_Normalized" />
    <bpmn:association id="Assoc_AIResult" sourceRef="Task_ReceiveAI" targetRef="Data_AIResult" />
    <bpmn:association id="Assoc_Validated" sourceRef="Task_MergeMapping" targetRef="Data_ValidatedMapping" />
  </bpmn:process>
  <bpmn:process id="Process_AI" name="AI SKU Matching Service" isExecutable="true">
    <bpmn:sequenceFlow id="SF_AI_1" sourceRef="Start_AI" targetRef="Task_Normalize" />
    <bpmn:sequenceFlow id="SF_AI_2" sourceRef="Task_Normalize" targetRef="Task_GetMasterSKU" />
    <bpmn:sequenceFlow id="SF_AI_3" sourceRef="Task_GetMasterSKU" targetRef="Task_Match" />
    <bpmn:sequenceFlow id="SF_AI_4" sourceRef="Task_Match" targetRef="Task_Confidence" />
    <bpmn:sequenceFlow id="SF_AI_5" sourceRef="Task_Confidence" targetRef="Task_SendAIResult" />
    <bpmn:sequenceFlow id="SF_AI_6" sourceRef="Task_SendAIResult" targetRef="End_AI" />
    <bpmn:sequenceFlow id="Flow_1rtlyvt" sourceRef="Start_AI" targetRef="Task_Normalize" />
    <bpmn:sequenceFlow id="Flow_1w1zbc4" sourceRef="Task_Normalize" targetRef="Task_GetMasterSKU" />
    <bpmn:sequenceFlow id="Flow_183yvis" sourceRef="Task_Match" targetRef="Task_Confidence" />
    <bpmn:sequenceFlow id="Flow_1khk2bo" sourceRef="Task_Confidence" targetRef="Task_SendAIResult" />
    <bpmn:endEvent id="End_AI" name="Результат передан">
      <bpmn:incoming>Flow_0v9s63g</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0v9s63g" sourceRef="Task_SendAIResult" targetRef="End_AI" />
    <bpmn:startEvent id="Start_AI" name="Получен dataset">
      <bpmn:outgoing>Flow_1rtlyvt</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_Start_AI" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Normalize" name="3.1. Нормализовать номенклатуру">
      <bpmn:incoming>Flow_1rtlyvt</bpmn:incoming>
      <bpmn:outgoing>Flow_1w1zbc4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GetMasterSKU" name="3.2. Получить эталонный каталог">
      <bpmn:incoming>Flow_1w1zbc4</bpmn:incoming>
      <bpmn:outgoing>Flow_1jbpfhi</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Match" name="3.3. Выполнить AI SKU Matching">
      <bpmn:incoming>Flow_1jbpfhi</bpmn:incoming>
      <bpmn:outgoing>Flow_183yvis</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1cvefzs">
        <bpmn:targetRef>Data_AI_Match</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Confidence" name="3.4. Рассчитать confidence">
      <bpmn:incoming>Flow_183yvis</bpmn:incoming>
      <bpmn:outgoing>Flow_1khk2bo</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_SendAIResult" name="3.5. Передать результат в Onboarding Service">
      <bpmn:incoming>Flow_1khk2bo</bpmn:incoming>
      <bpmn:outgoing>Flow_0v9s63g</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:dataObjectReference id="Data_AI_Match" name="AI Matching Result" />
    <bpmn:sequenceFlow id="Flow_1jbpfhi" sourceRef="Task_GetMasterSKU" targetRef="Task_Match" />
    <bpmn:association id="Assoc_AI_Data" sourceRef="Task_Confidence" targetRef="Data_AI_Match" />
  </bpmn:process>
  <bpmn:process id="Process_ERP" name="VitaStore ERP" isExecutable="true">
    <bpmn:sequenceFlow id="SF_ERP_1" sourceRef="Start_ERP_Catalog" targetRef="Task_ProvideMasterSKU" />
    <bpmn:sequenceFlow id="SF_ERP_2" sourceRef="Task_ProvideMasterSKU" targetRef="End_ERP_Catalog" />
    <bpmn:sequenceFlow id="SF_ERP_3" sourceRef="Start_ERP_Mapping" targetRef="Task_UpdateERP" />
    <bpmn:sequenceFlow id="SF_ERP_4" sourceRef="Task_UpdateERP" targetRef="Task_SendPOSData" />
    <bpmn:sequenceFlow id="SF_ERP_5" sourceRef="Task_SendPOSData" targetRef="Task_SendStatus" />
    <bpmn:sequenceFlow id="SF_ERP_6" sourceRef="Task_SendStatus" targetRef="End_ERP_Mapping" />
    <bpmn:serviceTask id="Task_UpdateERP" name="4.2. Обновить Master / Store Data">
      <bpmn:incoming>Flow_1kbvmdb</bpmn:incoming>
      <bpmn:outgoing>Flow_1fmx56h</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="Start_ERP_Mapping" name="Получен Validated Mapping">
      <bpmn:outgoing>Flow_1kbvmdb</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_ERP_Mapping" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_SendPOSData" name="4.3. Сформировать POS dataset">
      <bpmn:incoming>Flow_1fmx56h</bpmn:incoming>
      <bpmn:outgoing>Flow_0orclh8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ERP_Mapping" name="Данные переданы">
      <bpmn:incoming>Flow_1jekd0d</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_SendStatus" name="4.4. Сформировать статус загрузки">
      <bpmn:incoming>Flow_0orclh8</bpmn:incoming>
      <bpmn:outgoing>Flow_1jekd0d</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_ProvideMasterSKU" name="4.1. Предоставить Master SKU">
      <bpmn:incoming>Flow_0idb7vr</bpmn:incoming>
      <bpmn:outgoing>Flow_1yaye4h</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="Start_ERP_Catalog" name="Запрос Master SKU">
      <bpmn:outgoing>Flow_0idb7vr</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_ERP_Catalog" />
    </bpmn:startEvent>
    <bpmn:endEvent id="End_ERP_Catalog" name="Каталог передан">
      <bpmn:incoming>Flow_1yaye4h</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1kbvmdb" sourceRef="Start_ERP_Mapping" targetRef="Task_UpdateERP" />
    <bpmn:sequenceFlow id="Flow_1fmx56h" sourceRef="Task_UpdateERP" targetRef="Task_SendPOSData" />
    <bpmn:sequenceFlow id="Flow_0orclh8" sourceRef="Task_SendPOSData" targetRef="Task_SendStatus" />
    <bpmn:sequenceFlow id="Flow_1jekd0d" sourceRef="Task_SendStatus" targetRef="End_ERP_Mapping" />
    <bpmn:sequenceFlow id="Flow_0idb7vr" sourceRef="Start_ERP_Catalog" targetRef="Task_ProvideMasterSKU" />
    <bpmn:sequenceFlow id="Flow_1yaye4h" sourceRef="Task_ProvideMasterSKU" targetRef="End_ERP_Catalog" />
  </bpmn:process>
  <bpmn:process id="Process_Merch" name="Товаровед" isExecutable="true">
    <bpmn:sequenceFlow id="SF_H_1" sourceRef="Start_Human" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="SF_H_2" sourceRef="Task_Review" targetRef="Task_Approve" />
    <bpmn:sequenceFlow id="SF_H_3" sourceRef="Task_Approve" targetRef="Task_ReturnHuman" />
    <bpmn:sequenceFlow id="SF_H_4" sourceRef="Task_ReturnHuman" targetRef="End_Human" />
    <bpmn:sequenceFlow id="Flow_1swh51v" sourceRef="Start_Human" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_0rimowd" sourceRef="Task_Review" targetRef="Task_Approve" />
    <bpmn:sequenceFlow id="Flow_1c0qv0t" sourceRef="Task_Approve" targetRef="Task_ReturnHuman" />
    <bpmn:sequenceFlow id="Flow_0sxujny" sourceRef="Task_ReturnHuman" targetRef="End_Human" />
    <bpmn:endEvent id="End_Human" name="Исключения обработаны">
      <bpmn:incoming>Flow_0sxujny</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Approve" name="5.2. Подтвердить mapping">
      <bpmn:incoming>Flow_0rimowd</bpmn:incoming>
      <bpmn:outgoing>Flow_1c0qv0t</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0x6i8jk">
        <bpmn:targetRef>Data_HumanMapping</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Review" name="5.1. Проверить спорные позиции">
      <bpmn:incoming>Flow_1swh51v</bpmn:incoming>
      <bpmn:outgoing>Flow_0rimowd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:dataObjectReference id="Data_HumanMapping" name="Human-approved Mapping" />
